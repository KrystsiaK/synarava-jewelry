{
  "name": "synarava-jewelry",
  "version": "0.3.4",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=1536' next dev",
    "postinstall": "prisma generate",
    "build": "next build --webpack",
    "start": "next start",
    "clean": "rm -rf .next",
    "check:version": "node scripts/check-version.mjs",
    "check:privacy": "node scripts/check-privacy-config.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "media:migrate-s3": "node scripts/migrate-local-uploads-to-s3.mjs",
    "translations:backfill": "node scripts/backfill-translations.mjs",
    "messages:generate": "node scripts/generate-messages-locale.mjs",
    "legal:export": "node scripts/export-legal-documents.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run && pnpm --filter @synarava/sku-core test && pnpm --filter @synarava/sku-contract test && pnpm --filter @synarava/sku-api test",
    "test:sku": "pnpm --filter @synarava/sku-core test && pnpm --filter @synarava/sku-contract test && pnpm --filter @synarava/sku-api test",
    "test:coverage": "vitest run --coverage",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:admin": "playwright test e2e/admin-",
    "test:a11y:prod-soft": "playwright test -c playwright.prod-soft.config.ts",
    "lhci:soft": "lhci autorun --config=lighthouserc.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/db-guard.mjs migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "node scripts/db-guard.mjs db push",
    "prisma:studio": "prisma studio",
    "mission-control:collect": "node --experimental-strip-types --import ./services/mission-control-collector/register.mjs ./services/mission-control-collector/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.7.0",
    "@synarava/shell-kit": "0.1.3",
    "@synarava/sku-contract": "workspace:*",
    "@synarava/wiring-engine": "0.2.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/gradient": "4.0.1-alpha.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/pattern": "4.0.1-alpha.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-storybook": "10.6.3",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "railway": "3.15.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
