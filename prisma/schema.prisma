generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminSession {
  id                     String   @id @default(uuid())
  tokenHash              String   @unique
  username               String
  ipAddress              String?
  userAgent              String?
  expiresAt              DateTime
  createdAt              DateTime @default(now())
  lastSeenAt             DateTime @default(now())
  lastShopifyReconcileAt DateTime?

  @@index([username])
  @@index([expiresAt])
}

model RateLimitBucket {
  keyHash   String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ShopifyCustomerSession {
  id                   String   @id
  accessToken          String
  refreshToken         String
  idToken              String
  accessTokenExpiresAt DateTime
  sessionExpiresAt     DateTime
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([accessTokenExpiresAt])
  @@index([sessionExpiresAt])
}

model Collection {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  code                  String?                 @unique
  name                  String
  subtitle              String?
  description           String?
  manifesto             String?
  symbolismLabel        String?
  symbolismTitle        String?
  symbolismBody         String?
  symbolismBody2        String?
  searchSummary         String?
  seoTitle              String?
  seoDescription        String?
  heroImageUrl          String?
  shopifyCollectionId   String?                 @unique
  shopifyManualSourceId String?                 @unique
  shopifyHandle         String?
  lastSyncedAt          DateTime?
  isStorefrontDefault   Boolean                 @default(false)
  status                CollectionStatus        @default(DRAFT)
  visibility            ContentVisibility       @default(PRIVATE)
  heroAssetId           String?
  coverAssetId          String?
  sortOrder             Int                     @default(0)
  publishedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  heroAsset             MediaAsset?             @relation("CollectionHeroAsset", fields: [heroAssetId], references: [id], onDelete: SetNull)
  coverAsset            MediaAsset?             @relation("CollectionCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  products              ProductCollection[]
  sections              CollectionSection[]
  translations          CollectionTranslation[]

  @@index([status, visibility, sortOrder])
}

model CollectionTranslation {
  id              String                  @id @default(cuid())
  locale          String
  name            String
  localizedHandle String?                 @unique
  subtitle        String?
  description     String?
  manifesto       String?
  symbolismLabel  String?
  symbolismTitle  String?
  symbolismBody   String?
  symbolismBody2  String?
  searchSummary   String?
  seoTitle        String?
  seoDescription  String?
  reviewStatus    TranslationReviewStatus @default(DRAFT)
  reviewedAt      DateTime?
  syncStatus      TranslationSyncStatus   @default(NOT_APPLICABLE)
  syncError       String?
  contentHash     String?
  lastSyncedAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  collectionId    String
  collection      Collection              @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@index([locale, reviewStatus])
  @@index([syncStatus, locale])
}

model CollectionSection {
  id           String                @id @default(cuid())
  type         CollectionSectionType
  title        String?
  eyebrow      String?
  body         String?
  content      Json?
  sortOrder    Int                   @default(0)
  collectionId String
  collection   Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, sortOrder])
}

model Product {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  sku                 String                  @unique
  name                String
  seriesLabel         String?
  subtitle            String?
  shortDescription    String?
  description         String?
  materialLine        String?
  symbolismLabel      String?
  symbolismTitle      String?
  symbolismBody       String?
  symbolismBody2      String?
  details             Json?
  currency            String                  @default("EUR")
  status              ProductStatus           @default(DRAFT)
  visibility          ContentVisibility       @default(PRIVATE)
  productType         String?
  priceCents          Int
  compareAtCents      Int?
  imageUrl            String?
  primaryAssetId      String?
  categoryId          String?
  searchSummary       String?
  seoTitle            String?
  seoDescription      String?
  vendor              String?
  shopifyCategoryId   String?
  shopifyCategoryName String?
  shopifySnapshot     Json?
  /// Synarava working commerce window (same Shopify-shaped JSON as shopifySnapshot).
  workingSnapshot     Json?
  /// @deprecated dual-snapshot model — unused; drop in a later migration.
  shopifyBaseSnapshot Json?
  shopifyProductId    String?                 @unique
  shopifyHandle       String?
  shopifyUpdatedAt    DateTime?
  lastSyncedAt        DateTime?
  syncStatus          ProductSyncStatus       @default(UNLINKED)
  syncError           String?
  searchDocument      String?
  publishedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  primaryAsset        MediaAsset?             @relation("ProductPrimaryAsset", fields: [primaryAssetId], references: [id], onDelete: SetNull)
  category            ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media               ProductMedia[]
  variants            ProductVariant[]
  optionValues        ProductOptionValue[]
  collections         ProductCollection[]
  tags                ProductTag[]
  characteristics     ProductCharacteristic[]
  syncEvents          ProductSyncEvent[]
  translations        ProductTranslation[]
  incomingUpdate      ProductIncomingUpdate?

  @@index([status, visibility, productType, publishedAt])
  @@index([status, visibility, publishedAt])
  @@index([categoryId])
}

model ProductIncomingUpdate {
  productId String   @id
  version   String
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  views     ProductIncomingUpdateView[]
}

model ProductIncomingUpdateView {
  productId     String
  adminUsername String
  viewedVersion String
  viewedAt      DateTime
  incoming      ProductIncomingUpdate @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([productId, adminUsername])
  @@index([adminUsername])
}

/// Dual full-catalog commerce snapshots (Redux-style store persistence).
model CommerceSyncStore {
  id              String   @id @default("default")
  ourSnapshot     Json
  shopifySnapshot Json
  conflictReport  Json?
  updatedAt       DateTime @updatedAt
}

model ProductTranslation {
  id               String                  @id @default(cuid())
  locale           String
  title            String
  localizedHandle  String?                 @unique
  shortDescription String?
  description      String?
  materialLine     String?
  symbolismLabel   String?
  symbolismTitle   String?
  symbolismBody    String?
  symbolismBody2   String?
  details          Json?
  seoTitle         String?
  seoDescription   String?
  reviewStatus     TranslationReviewStatus @default(DRAFT)
  reviewedAt       DateTime?
  syncStatus       TranslationSyncStatus   @default(NOT_APPLICABLE)
  syncError        String?
  contentHash      String?
  lastSyncedAt     DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  productId        String
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale, reviewStatus])
  @@index([syncStatus, locale])
}

model ProductCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([sortOrder, name])
}

model Tag {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  ProductTag[]
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
}

model ProductMedia {
  id        String     @id @default(cuid())
  kind      MediaRole  @default(GALLERY)
  alt       String?
  caption   String?
  sortOrder Int        @default(0)
  productId String
  assetId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation("ProductMediaAsset", fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([productId, assetId])
  @@index([productId, sortOrder])
}

model ProductOption {
  id        String               @id @default(cuid())
  key       String
  name      String
  type      ProductOptionType    @default(TEXT)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  values    ProductOptionValue[]

  @@unique([key, name])
}

model ProductOptionValue {
  id        String                      @id @default(cuid())
  value     String
  label     String
  hex       String?
  sortOrder Int                         @default(0)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  optionId  String
  productId String?
  option    ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  product   Product?                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants  ProductVariantOptionValue[]

  @@unique([optionId, productId, value])
  @@index([optionId, sortOrder])
}

model ProductVariant {
  id                     String                      @id @default(cuid())
  sku                    String                      @unique
  title                  String
  priceCents             Int
  compareAtCents         Int?
  inventoryPolicy        InventoryPolicy             @default(DENY)
  stockOnHand            Int                         @default(0)
  barcode                String?
  taxable                Boolean                     @default(true)
  /** Shopify InventoryItem.unitCost in cents (shop currency). Null = unset. */
  costCents              Int?
  requiresShipping       Boolean                     @default(true)
  tracked                Boolean                     @default(true)
  weightGrams            Decimal?                    @db.Decimal(14, 4)
  imageUrl               String?
  selectedOptions        Json?
  status                 ProductStatus               @default(DRAFT)
  shopifyVariantId       String?                     @unique
  shopifyInventoryItemId String?                     @unique
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  productId              String
  product                Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues           ProductVariantOptionValue[]

  @@index([productId, status])
}

model ProductCharacteristic {
  id             String                  @id @default(cuid())
  productId      String
  key            String
  label          String
  group          String
  valueType      CharacteristicValueType
  textValue      String?
  numberValue    Decimal?                @db.Decimal(14, 4)
  booleanValue   Boolean?
  unit           String?
  certificateUrl String?
  searchable     Boolean                 @default(true)
  filterable     Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([key, textValue])
  @@index([key, numberValue])
  @@index([key, booleanValue])
  @@index([productId, group, sortOrder])
}

model ProductSyncEvent {
  id               String          @id @default(cuid())
  productId        String?
  shopifyProductId String?
  shopifyWebhookId String?         @unique
  direction        SyncDirection
  status           SyncEventStatus @default(PENDING)
  topic            String?
  payload          Json?
  error            String?
  attemptCount     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  completedAt      DateTime?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([status, createdAt])
  @@index([shopifyProductId])
}

model ProductVariantOptionValue {
  id            String             @id @default(cuid())
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
}

model ProductCollection {
  id           String     @id @default(cuid())
  sortOrder    Int        @default(0)
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model MediaAsset {
  id                 String         @id @default(cuid())
  key                String         @unique
  bucket             String?
  filename           String
  mimeType           String
  extension          String?
  width              Int?
  height             Int?
  sizeBytes          Int?
  alt                String?
  focalPointX        Float?
  focalPointY        Float?
  status             AssetStatus    @default(READY)
  source             AssetSource    @default(UPLOAD)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  // Admin operator username at upload time (admin auth is env-credential
  // based, not a User row — see AuditLog.adminUsername for the same pattern).
  uploadedByUsername String?
  productPrimaryFor  Product[]      @relation("ProductPrimaryAsset")
  collectionHeroFor  Collection[]   @relation("CollectionHeroAsset")
  collectionCoverFor Collection[]   @relation("CollectionCoverAsset")
  productMedia       ProductMedia[] @relation("ProductMediaAsset")
}

model Page {
  id                 String            @id @default(cuid())
  slug               String            @unique
  title              String
  template           PageTemplate
  excerpt            String?
  searchSummary      String?
  seoTitle           String?
  seoDescription     String?
  status             PageStatus        @default(DRAFT)
  visibility         ContentVisibility @default(PRIVATE)
  publishedAt        DateTime?
  content            Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Admin operator username at authoring time — see MediaAsset.uploadedByUsername.
  authoredByUsername String?
  shopifyPageId      String?           @unique
  shopifyHandle      String?
  translations       PageTranslation[]
}

model PageTranslation {
  id              String                  @id @default(cuid())
  locale          String
  title           String
  localizedHandle String?                 @unique
  excerpt         String?
  content         Json?
  seoTitle        String?
  seoDescription  String?
  reviewStatus    TranslationReviewStatus @default(DRAFT)
  reviewedAt      DateTime?
  syncStatus      TranslationSyncStatus   @default(NOT_APPLICABLE)
  syncError       String?
  contentHash     String?
  lastSyncedAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  pageId          String
  page            Page                    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([locale, reviewStatus])
  @@index([syncStatus, locale])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalizedHandleRedirect {
  id         String        @id @default(cuid())
  entityType String
  entityId   String
  locale     String
  fromHandle String
  toHandle   String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([entityType, locale, fromHandle])
  @@index([entityType, entityId, locale])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @default(now())
  adminSessionId String?
  adminUsername  String?

  @@index([entityType, entityId, createdAt])
  @@index([adminSessionId, createdAt])
}

model AdminIssue {
  id                 String           @id @default(cuid())
  key                String           @unique
  entityType         String
  entityId           String
  entityLabel        String
  fieldPath          String
  issueType          String
  severity           String           @default("ERROR")
  status             AdminIssueStatus @default(OPEN)
  title              String
  description        String
  targetHref         String
  metadata           Json?
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @updatedAt
  resolvedAt         DateTime?
  notificationSentAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, severity, updatedAt])
  @@index([entityType, entityId])
}

enum ContentVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CollectionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CollectionSectionType {
  HERO
  MANIFESTO
  MATERIALS
  GALLERY
  STORY
  FEATURE_LIST
  CTA
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  UNLISTED
}

enum ProductSyncStatus {
  UNLINKED
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum TranslationReviewStatus {
  DRAFT
  REVIEWED
}

enum TranslationSyncStatus {
  NOT_APPLICABLE
  PENDING
  SYNCED
  FAILED
  CONFLICT
}

enum CharacteristicValueType {
  TEXT
  NUMBER
  BOOLEAN
}

enum SyncDirection {
  PUSH
  PULL
  RECONCILE
}

enum SyncEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CONFLICT
  IGNORED
}

enum ProductOptionType {
  TEXT
  COLOR
  MATERIAL
}

enum InventoryPolicy {
  DENY
  CONTINUE
}

enum MediaRole {
  PRIMARY
  GALLERY
  DETAIL
  LOOKBOOK
}

enum AssetStatus {
  PENDING
  READY
  ARCHIVED
}

enum AssetSource {
  UPLOAD
  GENERATED
  IMPORTED
}

enum PageTemplate {
  HOME
  MANIFESTO
  COLLECTION_INDEX
  STATIC_PAGE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Generic Shopify identity + retryable sync history for the translation
// platform, shared by every entity (Product, Collection, Page, and
// structured content synced through an app-owned metaobject) — kept apart
// from ProductSyncEvent, which is commerce (inventory/price/catalog) sync,
// not translations. See tasks/plan.md "Persistence и миграция".
model ShopifyTranslationBinding {
  id                 String                  @id @default(cuid())
  resourceType       TranslationResourceType
  entityId           String
  shopifyResourceId  String
  // Legacy, single-locale field values (registry key -> value) as of the
  // last successful push/pull, from before per-locale ShopifyTranslationSnapshot
  // rows existed — only ever populated for one locale and no longer written
  // (Task U5), kept as a read-only fallback for bindings that predate it.
  lastSyncedSnapshot Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  syncEvents         TranslationSyncEvent[]
  snapshots          ShopifyTranslationSnapshot[]
  divergences        ShopifyFieldDivergence[]

  @@unique([resourceType, entityId])
  @@unique([resourceType, shopifyResourceId])
}

// Locale-specific common ancestors for three-way comparison, one row per
// (binding, locale). The legacy lastSyncedSnapshot column on
// ShopifyTranslationBinding remains only so bindings created before this
// table existed still have a fallback base to diff against.
model ShopifyTranslationSnapshot {
  id        String                    @id @default(cuid())
  bindingId String
  binding   ShopifyTranslationBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  locale    String
  values    Json
  syncedAt  DateTime                  @default(now())
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([bindingId, locale])
  @@index([locale, syncedAt])
}

// A read-only observation of Shopify/local state. Reconcile runs are kept
// separate from TranslationSyncEvent because opening the admin may perform
// a check but must never imply or trigger a write.
model ShopifyReconcileRun {
  id              String                 @id @default(cuid())
  trigger         ShopifyReconcileTrigger
  status          ShopifyReconcileStatus @default(QUEUED)
  scope           Json?
  requestedBy     String?
  checkedCount    Int                    @default(0)
  differenceCount Int                    @default(0)
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  divergences     ShopifyFieldDivergence[]

  @@index([status, createdAt])
  @@index([completedAt])
}

// Latest catalog-level identity comparison. Field divergences belong to
// ShopifyReconcileRun; entities present on only one side need their own
// persisted snapshot because a Shopify-only product/collection has no local row.
// Snapshot ids: "catalog" (products), "collections" (collections).
model ShopifyCatalogPresenceSnapshot {
  id          String   @id @default("catalog")
  runId       String?
  differences Json
  checkedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Only unequal, actionable localized fields are stored. Equal fields and
// shared commerce/media state never become disabled noise in the merge UI.
model ShopifyFieldDivergence {
  id                String                           @id @default(cuid())
  runId             String
  run               ShopifyReconcileRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  bindingId         String
  binding           ShopifyTranslationBinding        @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  rootEntityType    String
  rootEntityId      String
  entityLabel       String
  locale            String
  fieldKey          String
  fieldLabel        String
  targetKind        ShopifyTranslationTargetKind
  kind              ShopifyFieldDifferenceKind
  baseValue         Json?
  localValue        Json?
  shopifyValue      Json?
  localFingerprint  String
  shopifyFingerprint String
  shopifyUpdatedAt  DateTime?
  shopifyOutdated   Boolean?
  resolutionToken   String?
  resolutionStartedAt DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  @@unique([runId, bindingId, locale, fieldKey])
  @@index([bindingId, locale])
  @@index([rootEntityType, rootEntityId, locale])
  @@index([kind, resolvedAt])
}

model TranslationSyncEvent {
  id             String                    @id @default(cuid())
  bindingId      String
  binding        ShopifyTranslationBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  locale         String
  direction      SyncDirection
  status         SyncEventStatus           @default(PENDING)
  fieldConflicts Json?
  error          String?
  actorUsername  String?
  scope          Json?
  selectedSide   String?
  localFingerprint String?
  shopifyFingerprint String?
  resultFingerprint String?
  shopifyResponse Json?
  attemptCount   Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  completedAt    DateTime?

  @@index([bindingId, createdAt])
  @@index([status, createdAt])
}

enum TranslationResourceType {
  PRODUCT
  COLLECTION
  PAGE
  METAOBJECT
}

enum ShopifyReconcileTrigger {
  AUTO
  MANUAL
  ENTITY
  LOCALE
}

enum ShopifyReconcileStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ShopifyTranslationTargetKind {
  NATIVE
  METAFIELD
  METAOBJECT
}

enum ShopifyFieldDifferenceKind {
  LOCAL_ONLY
  SHOPIFY_ONLY
  CONFLICT
}

model TranslationCache {
  locale    String   @id
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Registry of storefront locales. Adding a new language (once published in
// Shopify Markets) is a row here, not a schema change or enum edit — see
// tasks/universal-localization-plan.md. `routeSegment` is operator-chosen
// and Shopify sync (`lib/shopify/storefront-locale-sync.ts`) never
// overwrites it; only `isPublished`/`shopifyUpdatedAt` come from Shopify.
model StorefrontLocale {
  id               String    @id @default(cuid())
  code             String    @unique
  routeSegment     String    @unique
  shopifyLocale    String    @unique
  intlLocale       String
  name             String
  nativeName       String
  isDefault        Boolean   @default(false)
  isPublished      Boolean   @default(false)
  sortOrder        Int       @default(0)
  shopifyUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([sortOrder])
}

enum AdminIssueStatus {
  OPEN
  RESOLVED
  IGNORED
}
