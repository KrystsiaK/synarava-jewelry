{
  "name": "@synarava/sku-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "SKU_DATABASE_URL=${SKU_DATABASE_URL:-postgresql://sku:sku@127.0.0.1:5432/sku} prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "postinstall": "pnpm prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@synarava/sku-contract": "workspace:*",
    "@synarava/sku-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
