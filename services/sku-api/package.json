{
  "name": "@synarava/sku-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "SKU_DATABASE_URL=${SKU_DATABASE_URL:-postgresql://sku:sku@127.0.0.1:5432/sku} prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "credentials:generate": "node ./scripts/generate-credentials.mjs",
    "audit:catalog": "node ./scripts/catalog-audit.mjs",
    "build": "tsc -p tsconfig.build.json && esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:../generated/prisma/index.js --outfile=dist/registry/main.js && node ./scripts/copy-prisma-client.mjs",
    "start": "node dist/registry/main.js",
    "dev": "pnpm build && SKU_API_DEV_TOKEN=${SKU_API_DEV_TOKEN:-dev-sku-token} node dist/registry/main.js",
    "postinstall": "pnpm prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@synarava/sku-contract": "workspace:*",
    "@synarava/sku-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "0.25.12",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
