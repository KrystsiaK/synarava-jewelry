{
  "description": "Repository guardrails for Synarava.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/protect-env-local.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking protected environment files"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "graphify check-update .",
            "timeout": 5,
            "statusMessage": "Checking project graph freshness"
          }
        ]
      }
    ]
  }
}
